# ============================================================================
# Sri Sri Maa Raksha Kali Mandir — V1.1.3
# Environment contract / safe template
# ============================================================================
#
# IMPORTANT:
# - This file contains NO production credentials.
# - Never put real secrets in .env.example.
# - Copy/configure values through the appropriate local or Cloudflare
#   environment/secret mechanism.
#
# Environment classes:
#
# PUBLIC_BUILD
#   Safe values that may legitimately be exposed to the browser/build.
#
# SERVER_CONFIG
#   Server-side configuration that is not itself a secret.
#
# SERVER_SECRET
#   Credentials, cryptographic secrets, provider keys or other sensitive data.
#
# WORKER_BINDING
#   Cloudflare runtime resources/bindings. These are configured in the
#   deployment/runtime configuration rather than exposed as NEXT_PUBLIC_*.
#
# Canonical mutable temple facts belong in the canonical data/configuration
# layer. They must not be scattered as UI constants.
# ============================================================================


# ============================================================================
# PUBLIC_BUILD
# ============================================================================
#
# These values are intentionally safe for browser/build exposure.
# They must never contain credentials, private keys or provider secrets.
# ============================================================================

NEXT_PUBLIC_SITE_URL=https://maarakshakali.pages.dev
NEXT_PUBLIC_SITE_NAME=শ্রী শ্রী মা রক্ষা কালী মন্দির
NEXT_PUBLIC_DEFAULT_LOCALE=bn-IN
NEXT_PUBLIC_GOOGLE_MAPS_URL=https://maps.app.goo.gl/AwerSG1peoGm2gUx9
NEXT_PUBLIC_WHATSAPP_GROUP_URL=https://chat.whatsapp.com/IRoYErTIKYF4Qr2bPl8FMX


# ============================================================================
# SERVER_CONFIG
# ============================================================================
#
# Non-secret server-side configuration.
# ============================================================================

# ----------------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------------

DATABASE_ID=raksha-kali-mandir-db


# ----------------------------------------------------------------------------
# Backblaze B2 object storage
# ----------------------------------------------------------------------------
#
# Production storage authority:
#   Provider: Backblaze B2
#   Bucket: raksha-kali-mandir-storage
#   Bucket ID: 48a58aafc4e2931aaf030011
#   Region: eu-central-003
#
# Credentials themselves belong below under SERVER_SECRET.
# ----------------------------------------------------------------------------

B2_BUCKET_NAME=raksha-kali-mandir-storage
B2_REGION=eu-central-003
B2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com


# ----------------------------------------------------------------------------
# Authentication/session configuration
# ----------------------------------------------------------------------------

SESSION_COOKIE_NAME=raksha_kali_session


# ----------------------------------------------------------------------------
# Donation configuration
# ----------------------------------------------------------------------------

UPI_VPA=7583992377@okbizaxis
UPI_PAYEE_NAME=Sri Sri Raksha Kali Mandir
UPI_TRANSACTION_NOTE=শ্রী শ্রী রক্ষা কালী মন্দির প্রণামী


# ----------------------------------------------------------------------------
# Email / support configuration
# ----------------------------------------------------------------------------
#
# EMAIL_FROM must eventually be a provider-verified production sender
# domain/address. Do not use pages.dev as the production sender domain.
# ----------------------------------------------------------------------------

EMAIL_FROM=
EMAIL_REPLY_TO=maarakshakalisahapur@gmail.com
SUPPORT_PRIMARY_EMAIL=maarakshakalisahapur@gmail.com
SUPPORT_BACKUP_EMAIL=maarakshakalisahapur@gmail.com


# ----------------------------------------------------------------------------
# Web push
# ----------------------------------------------------------------------------

NOTIFICATION_VAPID_PUBLIC_KEY=


# ----------------------------------------------------------------------------
# AI configuration
# ----------------------------------------------------------------------------
#
# AI is an application capability above the canonical query/read-model and
# deterministic engine layers. It is never the source of truth.
# ----------------------------------------------------------------------------

AI_MODEL=


# ----------------------------------------------------------------------------
# Optional document-processing configuration
# ----------------------------------------------------------------------------

DOCUMENT_SCANNER_ENDPOINT=
DOCUMENT_OCR_ENDPOINT=


# ============================================================================
# SERVER_SECRET
# ============================================================================
#
# Leave blank in this example.
# Real values MUST be provisioned through the appropriate secret store.
# Never expose these through NEXT_PUBLIC_* variables.
# ============================================================================

# ----------------------------------------------------------------------------
# Backblaze B2 credentials
# ----------------------------------------------------------------------------

B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=


# ----------------------------------------------------------------------------
# Authentication / anti-abuse
# ----------------------------------------------------------------------------

AUTH_SECRET=
TURNSTILE_SECRET_KEY=


# ----------------------------------------------------------------------------
# Web push private credential
# ----------------------------------------------------------------------------

NOTIFICATION_VAPID_PRIVATE_KEY=


# ----------------------------------------------------------------------------
# AI provider credential
# ----------------------------------------------------------------------------

AI_PROVIDER_API_KEY=


# ----------------------------------------------------------------------------
# Error reporting
# ----------------------------------------------------------------------------

ERROR_REPORTING_DSN=


# ----------------------------------------------------------------------------
# Resend
# ----------------------------------------------------------------------------

RESEND_API_KEY=


# ----------------------------------------------------------------------------
# Jaba / participant identity infrastructure
# ----------------------------------------------------------------------------
#
# These are server-only and must never be sent to the browser.
# JABA identity material must not use raw personal data as a public identifier.
# ----------------------------------------------------------------------------

JABA_OTP_PROVIDER_CONFIG=
JABA_IDENTITY_SALT=
JABA_RATE_LIMIT_CONFIG=


# ----------------------------------------------------------------------------
# Music serving
# ----------------------------------------------------------------------------
#
# Required only when the final serving architecture actually uses private
# signed CDN/object URLs.
# ----------------------------------------------------------------------------

MUSIC_CDN_PRIVATE_SIGNING_SECRET=


# ============================================================================
# WORKER_BINDING
# ============================================================================
#
# These are Cloudflare runtime resources, not browser environment variables.
# They should be defined in the Cloudflare deployment/runtime configuration
# and accessed through server/Worker bindings.
#
# Production binding/resource names:
#
#   D1:
#     raksha-kali-mandir-db
#
#   KV cache:
#     raksha-kali-mandir-cache
#
#   KV session:
#     mandir-session-store
#
#   Turnstile:
#     maarakshakali-portal
#
# Do NOT put binding credentials in this section.
# Do NOT create NEXT_PUBLIC_* versions of private/runtime bindings.
# ============================================================================
