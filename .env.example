# Sri Sri Maa Raksha Kali Mandir — V1.1.3 environment contract
#
# This file is a safe template only. Never place real secrets in .env.example.
# Copy values into the appropriate local/Cloudflare secret/config store.
#
# Classes:
# PUBLIC_BUILD    = safe to expose to the browser/build output
# SERVER_CONFIG   = server-side non-secret configuration
# SERVER_SECRET   = server-side secret/credential material
# WORKER_BINDING  = Cloudflare runtime binding identifiers/resources, not browser env
#
# Canonical mutable temple/product facts belong in the canonical data/config layer,
# not in arbitrary UI constants or this template.

# -----------------------------------------------------------------------------
# PUBLIC_BUILD
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://maarakshakali.pages.dev
NEXT_PUBLIC_SITE_NAME=শ্রী শ্রী মা রক্ষা কালী মন্দির
NEXT_PUBLIC_DEFAULT_LOCALE=bn-IN
NEXT_PUBLIC_GOOGLE_MAPS_URL=https://maps.app.goo.gl/AwerSG1peoGm2gUx9
NEXT_PUBLIC_WHATSAPP_GROUP_URL=https://chat.whatsapp.com/IRoYErTIKYF4Qr2bPl8FMX

